# Server-only secret. Never commit the real value; used only by db/migrate.ts
# and the Data API calls this backend makes on the caller's behalf.
DATABASE_URL=postgresql://user:password@YOUR-PROJECT-pooler.region.aws.neon.tech/neondb?sslmode=require

# Public Neon Auth / Data API URLs (not secrets — see README "Environment
# Variables"). Produced by `neon deploy` (backend/../neon.ts) into the repo
# root's .env.local, or from the Neon console's Auth / Data API pages.
NEON_AUTH_BASE_URL=https://YOUR-PROJECT.neonauth.region.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://YOUR-PROJECT.neonauth.region.aws.neon.tech/neondb/auth/.well-known/jwks.json
NEON_DATA_API_URL=https://YOUR-PROJECT.apirest.region.aws.neon.tech/neondb/rest/v1

# Origin allowed to call this API.
FRONTEND_URL=http://localhost:5173

PORT=3001
