# Public — not secrets, safe to expose in the browser bundle. Vite only
# exposes vars prefixed with VITE_; see README "Environment Variables".
VITE_NEON_AUTH_BASE_URL=https://YOUR-PROJECT.neonauth.region.aws.neon.tech/neondb/auth
VITE_NEON_DATA_API_URL=https://YOUR-PROJECT.apirest.region.aws.neon.tech/neondb/rest/v1

# This app's own backend (see ../backend).
VITE_API_URL=http://localhost:3001/api
